# Python virtual environment

# .venv contains thousands of environment/dependency files created locally.

# It is NOT part of the project source code and should never be committed to Git.

.venv/
venv/
env/

# Python cache files

# These are automatically generated when Python runs/imports modules.

**pycache**/
*.py[cod]

# Pytest cache

# Automatically generated when running tests with pytest.

.pytest_cache/

# Environment/secrets files

# These may contain local configuration or sensitive values such as API keys.

.env

# Keep the example configuration file so other developers know what variables are needed.

!.env.example

# IDE/editor files

# Local VS Code settings should generally not be committed.

.vscode/

# Operating system files

# Automatically generated by Windows/macOS.

.DS_Store
Thumbs.db
